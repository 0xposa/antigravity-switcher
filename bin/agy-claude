#!/usr/bin/env bash
# agy-auto / agy-claude: Antigravity runner with auto-rotation for any model
set -e

MODEL="claude-opus-4-6-thinking"
ARGS=()

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    --model)
      MODEL="$2"
      shift 2
      ;;
    --model=*)
      MODEL="${1#*=}"
      shift
      ;;
    --gemini)
      MODEL="gemini-3.8-flash-high"
      shift
      ;;
    --sonnet)
      MODEL="claude-sonnet-4-6"
      shift
      ;;
    --opus)
      MODEL="claude-opus-4-6-thinking"
      shift
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

echo -e "\033[1;34m========================================================\033[0m"
echo -e "\033[1;32m       Antigravity Auto-Runner (Model Rotator)          \033[0m"
echo -e "  Model aktif: \033[1;33m$MODEL\033[0m"
echo -e "\033[1;34m========================================================\033[0m"

# Tampilkan akun yang aktif jika agy-switcher tersedia
if command -v agy-switcher >/dev/null 2>&1; then
  agy-switcher --list | grep "\[AKTIF\]" || true
fi

# Jalankan sesi pertama
echo -e "\n\033[1;32m[1/2] Memulai sesi dengan model $MODEL...\033[0m"
agy --model "$MODEL" "${ARGS[@]}" || true

# Loop auto-rotate jika sesi keluar / limit
while true; do
  echo -e "\n\033[1;33m--------------------------------------------------------\033[0m"
  echo -e "Sesi selesai atau kuota model '$MODEL' mungkin telah mencapai limit."
  read -p "Tekan [Enter] untuk rotasi akun & LANJUTKAN task, atau 'q' untuk keluar: " choice
  
  if [ "$choice" = "q" ] || [ "$choice" = "Q" ]; then
    echo "Selesai."
    break
  fi

  # Lakukan rotasi akun
  echo -e "\n\033[1;36m[Auto-Switch] Melakukan rotasi ke akun berikutnya...\033[0m"
  if command -v agy-switcher >/dev/null 2>&1; then
    agy-switcher --rotate || {
      echo "Gagal rotasi akun. Pastikan Anda sudah menambahkan minimal 2 akun via menu 'agy-switcher'."
      break
    }
  else
    echo "Perintah agy-switcher tidak ditemukan di PATH."
    break
  fi

  echo -e "\033[1;32m[Auto-Switch] Melanjutkan task terakhir dengan akun baru (agy --continue)...\033[0m\n"
  agy --model "$MODEL" --continue || true
done
