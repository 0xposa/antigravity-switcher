def print_list(lang="id", show_back=False):
    clear_screen()
    t = TEXTS[lang]
    print(get_cat_banner(lang))
    sync_active_token()
    accounts = get_accounts()
    print(f"\n\033[1;36m================= {t['list_title']} =================\033[0m")
    if not accounts:
        print(f" {t['no_acc']}")
    else:
        for idx, acc in enumerate(accounts, 1):
            tag = f" \033[1;32m{t['active_tag']}\033[0m" if acc["is_active"] else ""
            rot_tag = " [Auto-Rotate: ✅ ON]" if acc["auto_rotate"] else " [Auto-Rotate: ⛔ OFF]"
            print(f" \033[1;33m{idx}.\033[0m \033[1;37m{acc['email']}\033[0m{tag}{rot_tag}")
            print(f"    \033[2mFile: {acc['file']} | Exp: {acc['expiry']}\033[0m")
    if show_back:
        print(f" \033[1;33m0.\033[0m \033[1;37m{t['back_opt']}\033[0m")
    print("\033[1;36m" + "=" * (len(t['list_title']) + 36) + "\033[0m")
    print(f"\033[1;32m{t['total']}: {len(accounts)}\033[0m\n")

def ui_manage_rotation_pool(lang="id"):
    t = TEXTS[lang]
    while True:
        clear_screen()
        print(get_cat_banner(lang))
        accounts = get_accounts()
        title = "KELOLA POOL AUTO-ROTATION" if lang == "id" else "MANAGE AUTO-ROTATION POOL"
        print(f"\n\033[1;36m================= {title} =================\033[0m")
        glob_st = "\033[1;32m✅ ON (AKTIF)\033[0m" if is_auto_rotation_enabled() else "\033[1;31m⛔ OFF (NONAKTIF)\033[0m"
        print(f" Status Zero-Interruption: {glob_st}")
        print("\033[2m(Hanya akun dengan status ✅ ON yang akan berputar saat kuota habis)\033[0m\n")
        
        for idx, acc in enumerate(accounts, 1):
            status = "\033[1;32m✅ ON\033[0m" if acc["auto_rotate"] else "\033[1;31m⛔ OFF\033[0m"
            curr = " \033[1;33m(sedang dipakai)\033[0m" if acc["is_active"] else ""
            print(f" {idx}. {acc['email']} = {status}{curr}")
        print(f" \033[1;35mG.\033[0m \033[1;37mToggle Zero-Interruption (Global ON/OFF)\033[0m")
        print(f" \033[1;33m0.\033[0m \033[1;37m{t['back_opt']}\033[0m")
        
        print("\033[1;36m" + "=" * 48 + "\033[0m")
        choice = input(t["pool_prompt"]).strip()
        
        if not choice or choice in ("0", "b", "back", "q", "exit"):
            break
        if choice.lower() in ("g", "global"):
            new_g = set_auto_rotation_enabled(not is_auto_rotation_enabled())
            st_g = "ON (✅)" if new_g else "OFF (⛔)"
            print(f"Status Zero-Interruption Auto-Rotation diubah ke: {st_g}")
            continue
        if choice.isdigit():
            idx = int(choice) - 1
            if 0 <= idx < len(accounts):
                target = accounts[idx]
                new_state = toggle_rotation_account(target["email"])
                st_str = "ON (✅)" if new_state else "OFF (⛔)"
                print(f"Status akun {target['email']} diubah ke: {st_str}")
            else:
                print("Nomor akun tidak valid.")
        else:
            print("Masukkan angka nomor akun.")

def ui_add_account(lang="id"):
    clear_screen()
    t = TEXTS[lang]
    print(get_cat_banner(lang))
    print(f"\n\033[1;32m{t['add_intro']}\033[0m")

    print(f"\n\033[1;33m{t['add_notice']}\033[0m")
    print(t["add_step1"])
    print(t["add_step2"])
    print(t["add_step3"])
    print(f"\n \033[1;33m0.\033[0m \033[1;37m{t['back_opt']}\033[0m\n")

    ans = input(f"\033[1;36m{t['add_press']}\033[0m").strip()
    if ans in ("0", "b", "back", "q", "exit"):
        print(f"\033[2m{t['add_cancel']}\033[0m")
        return False
    
    if os.path.exists(ACTIVE_TOKEN):
        curr_email = get_email_from_token_file(ACTIVE_TOKEN)
        curr_name = curr_email if curr_email else "current_account"
        save_current_token(curr_name)

    temp_backup = os.path.join(AGY_DIR, "temp_current_token.bak")
    if os.path.exists(ACTIVE_TOKEN):
        shutil.move(ACTIVE_TOKEN, temp_backup)

    try:
        subprocess.run(["agy"])
    except Exception as e:
        print(f"Error: {e}")

    if os.path.exists(ACTIVE_TOKEN):
        new_email = get_email_from_token_file(ACTIVE_TOKEN)
        name = new_email if new_email else "new_account"
        dest = os.path.join(ACCOUNTS_DIR, f"{name}.token")
        shutil.copy2(ACTIVE_TOKEN, dest)
        # Register new account in rotation config as enabled
        rot_cfg = get_rotation_config()
        rot_cfg[new_email] = True
        save_rotation_config(rot_cfg)
        print(f"\n\033[1;32m{t['add_success']} {new_email}\033[0m")
    else:
        print(f"\n\033[1;31m{t['add_failed']}\033[0m")
        if os.path.exists(temp_backup):
            shutil.move(temp_backup, ACTIVE_TOKEN)

    if os.path.exists(temp_backup):
        try:
            os.remove(temp_backup)
        except Exception:
            pass
    return True

def ui_remove_account(lang="id"):
    t = TEXTS[lang]
    print_list(lang, show_back=True)
    accounts = get_accounts()
    if not accounts:
        return False

    choice = input(f"\033[1;33m{t['del_prompt']}\033[0m").strip()
    if not choice or choice in ("0", "b", "back", "q", "exit"):
        print(f"\033[2m{t['del_cancel']}\033[0m")
        return False

    target = None
    if choice.isdigit():
        idx = int(choice) - 1
        if 0 <= idx < len(accounts):
            target = accounts[idx]
    else:
        for acc in accounts:
            if choice.lower() in acc["email"].lower():
                target = acc
                break

    if not target:
        print(f"\033[1;31m{t['del_not_found']}\033[0m")
        return True

    confirm = input(f"\033[1;31m{t['del_confirm'].format(target['email'])}\033[0m").strip().lower()
    if confirm in ("y", "yes", "ya"):
        was_active = target["is_active"]
        try:
            os.remove(target["path"])
            # Remove from rotation config
            rot_cfg = get_rotation_config()
            if target["email"] in rot_cfg:
                del rot_cfg[target["email"]]
                save_rotation_config(rot_cfg)
            print(f"\033[1;32m{t['del_success'].format(target['email'])}\033[0m")
            if was_active:
                remaining = get_accounts()
                if remaining:
                    print(t["del_was_active"])
                    shutil.copy2(remaining[0]["path"], ACTIVE_TOKEN)
                    print(f"Aktif sekarang: {remaining[0]['email']}")
        except Exception as e:
            print(f"Error removing account: {e}")
    else:
        print(f"\033[2m{t['del_cancel']}\033[0m")
    return True

def interactive_loop():
    global IS_INTERACTIVE
    IS_INTERACTIVE = True
    play_welcome_sound()
    # 1. Pilih Bahasa (Layar bersih)
    clear_screen()
    print(get_cat_banner("id"))
    print("\n\033[1;36mPilih Bahasa / Select Language:\033[0m")
    print(" \033[1;33m1.\033[0m Bahasa Indonesia")
    print(" \033[1;33m2.\033[0m English")
    print(" \033[1;33m3.\033[0m Keluar / Exit")
    print("\033[2m───────────────────────────────────────────────\033[0m")
    print("\033[2m(Tekan Ctrl+C untuk keluar / Press Ctrl+C to exit)\033[0m")
    print("\033[2m───────────────────────────────────────────────\033[0m")
    lang_choice = input("Pilih [1/2/3] (default: 1, 3 untuk keluar / 3 to exit): ").strip()
    if lang_choice in ("3", "0", "q", "exit"):
        clear_screen()
        print(get_cat_banner("id"))
        print("\nSampai jumpa! / Goodbye!\n")
        play_exit_sound()
        return
    lang = "en" if lang_choice == "2" else "id"

    t = TEXTS[lang]
    err_msg = ""

    # 2. Menu Utama (Setiap aksi membersihkan layar agar tetap di tempat)
    while True:
        clear_screen()
        print(get_cat_banner(lang))
        print(f"\n\033[1;34m{t['menu_title']}\033[0m")
        print("\033[1;34m───────────────────────────────────────────────\033[0m")
        print(f" \033[1;37m1.\033[0m {t['opt1']}")
        print(f" \033[1;37m2.\033[0m {t['opt2']}")
        print(f" \033[1;37m3.\033[0m {t['opt3']}")
        print(f" \033[1;37m4.\033[0m {t['opt4']}")
        print(f" \033[1;37m5.\033[0m {t['opt5']}")
        print("\033[2m───────────────────────────────────────────────\033[0m")
        print(f" {t['ctrl_c_hint']}")
        print("\033[2m───────────────────────────────────────────────\033[0m")
        if err_msg:
            print(f"\033[1;31m{err_msg}\033[0m\n")
            err_msg = ""

        choice = input(t["choose"]).strip()

        if choice == "1":
            proceed = ui_add_account(lang)
            if proceed:
                input(f"\n\033[2m{t['press_enter']}\033[0m")
        elif choice == "2":
            proceed = ui_remove_account(lang)
            if proceed:
                input(f"\n\033[2m{t['press_enter']}\033[0m")
        elif choice == "3":
            print_list(lang, show_back=True)
            input(f"\033[2m{t['press_enter']}\033[0m")
        elif choice == "4":
            ui_manage_rotation_pool(lang)
        elif choice == "5":
            clear_screen()
            print(get_cat_banner(lang))
            print("\nSampai jumpa! / Goodbye!\n")
            play_exit_sound()
            break
        else:
            err_msg = t["invalid"]

# ----------------- CLI Argument Handler -----------------

def main():
    try:
        prog_name = os.path.basename(sys.argv[0]).lower()
        if "rotation" in prog_name and len(sys.argv) == 1:
            ok, res = rotate_account_internal()
            if ok:
                print(f"OK:{res}")
                sys.exit(0)
            else:
                print(f"ERR:{res}", file=sys.stderr)
                sys.exit(1)

        if len(sys.argv) == 1:
            interactive_loop()
            return

        arg1 = sys.argv[1].lower()

        if arg1 in ("--rotate", "rotate"):
            ok, res = rotate_account_internal()
            if ok:
                print(f"OK:{res}")
                sys.exit(0)
            else:
                print(f"ERR:{res}", file=sys.stderr)
                sys.exit(1)

        elif arg1 in ("--auto-rotate-on", "auto-rotate-on", "--enable-auto-rotate"):
            set_auto_rotation_enabled(True)
            print("OK:ENABLED")
            sys.exit(0)

        elif arg1 in ("--auto-rotate-off", "auto-rotate-off", "--disable-auto-rotate"):
            set_auto_rotation_enabled(False)
            print("OK:DISABLED")
            sys.exit(0)

        elif arg1 in ("--auto-rotate-status", "auto-rotate-status"):
            st = is_auto_rotation_enabled()
            print("ENABLED" if st else "DISABLED")
            sys.exit(0)

        elif arg1 in ("--auto-rotate", "auto-rotate"):
            if len(sys.argv) < 3:
                st = is_auto_rotation_enabled()
                print("ENABLED" if st else "DISABLED")
                sys.exit(0)
            sub = sys.argv[2].lower()
            if sub in ("on", "enable", "1", "true"):
                set_auto_rotation_enabled(True)
                print("OK:ENABLED")
                sys.exit(0)
            elif sub in ("off", "disable", "0", "false"):
                set_auto_rotation_enabled(False)
                print("OK:DISABLED")
                sys.exit(0)
            elif sub in ("status", "check"):
                st = is_auto_rotation_enabled()
                print("ENABLED" if st else "DISABLED")
                sys.exit(0)
            else:
                print("ERR:Invalid option. Use 'on' or 'off'.", file=sys.stderr)
                sys.exit(1)

        elif arg1 in ("--switch", "switch"):
            if len(sys.argv) < 3:
                print("ERR:Target account required", file=sys.stderr)
                sys.exit(1)
            ok, res = switch_account_internal(sys.argv[2])
            if ok:
                print(f"OK:{res}")
                sys.exit(0)
            else:
                print(f"ERR:{res}", file=sys.stderr)
                sys.exit(1)

        elif arg1 in ("--toggle", "toggle"):
            if len(sys.argv) < 3:
                print("ERR:Target email required", file=sys.stderr)
                sys.exit(1)
            st = toggle_rotation_account(sys.argv[2])
            print("ON" if st else "OFF")
            sys.exit(0)

        elif arg1 in ("--list-json", "list-json"):
            sync_active_token()
            accs = get_accounts()
            print(json.dumps(accs, indent=2))
            sys.exit(0)

        elif arg1 in ("--toggle-model", "toggle-model"):
            if len(sys.argv) < 3:
                print("ERR:Target model required", file=sys.stderr)
                sys.exit(1)
            ok, res, st = toggle_model_rotation(sys.argv[2])
            if ok:
                print(f"OK:{res}:{'ON' if st else 'OFF'}")
                sys.exit(0)
            else:
                print(f"ERR:{res}", file=sys.stderr)
                sys.exit(1)

        elif arg1 in ("--set-model", "set-model"):
            if len(sys.argv) < 3:
                print("ERR:Target model required", file=sys.stderr)
                sys.exit(1)
            ok, res = set_model_internal(sys.argv[2])
            if ok:
                print(f"OK:{res}")
                sys.exit(0)
            else:
                print(f"ERR:{res}", file=sys.stderr)
                sys.exit(1)

        elif arg1 in ("--set-effort", "set-effort"):
            if len(sys.argv) < 3:
                print("ERR:Effort required (low, medium, high)", file=sys.stderr)
                sys.exit(1)
            ok, res = set_effort_internal(sys.argv[2])
            if ok:
                print(f"OK:{res}")
                sys.exit(0)
            else:
                print(f"ERR:{res}", file=sys.stderr)
                sys.exit(1)

        elif arg1 in ("--nav-model", "nav-model"):
            if len(sys.argv) < 3:
                print("ERR:Direction required (up, down)", file=sys.stderr)
                sys.exit(1)
            ok, res = nav_model_internal(sys.argv[2])
            if ok:
                print(f"OK:{res}")
                sys.exit(0)
            else:
                print(f"ERR:{res}", file=sys.stderr)
                sys.exit(1)

        elif arg1 in ("--nav-effort", "nav-effort"):
            if len(sys.argv) < 3:
                print("ERR:Direction required (left, right)", file=sys.stderr)
                sys.exit(1)
            ok, res = nav_effort_internal(sys.argv[2])
            if ok:
                print(f"OK:{res}")
                sys.exit(0)
            else:
                print(f"ERR:{res}", file=sys.stderr)
                sys.exit(1)

        elif arg1 in ("--status-json", "status-json"):
            sync_active_token()
            accs = get_accounts()
            current_model = get_current_model()
            current_effort = get_current_effort()
            active_email = get_email_from_token_file(ACTIVE_TOKEN)
            models_status = get_models_status()
            status_data = {
                "active_model": current_model,
                "active_email": active_email,
                "effort": current_effort,
                "auto_rotation_enabled": is_auto_rotation_enabled(),
                "accounts": accs,
                "rotation_pool": [a["email"] for a in accs if a["auto_rotate"]],
                "models": models_status,
                "model_rotation_pool": [m["name"] for m in models_status if m["auto_rotate"]]
            }
            print(json.dumps(status_data, indent=2))
            sys.exit(0)

        elif arg1 in ("--list", "list"):
            print_list("id")
            sys.exit(0)

        elif arg1 in ("--active-email", "active-email"):
            sync_active_token()
            email = get_email_from_token_file(ACTIVE_TOKEN)
            print(email or "None")
            sys.exit(0)

        else:
            interactive_loop()

    except (KeyboardInterrupt, EOFError):
        clear_screen()
        print("\nKeluar dari program (Ctrl+C). Sampai jumpa! / Goodbye!\n")
        if IS_INTERACTIVE:
            play_exit_sound()
        sys.exit(0)

if __name__ == "__main__":
    main()
