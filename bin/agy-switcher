# ----------------- Helper Functions -----------------

def get_email_from_token_file(filepath):
    if not os.path.exists(filepath):
        return None
    try:
        with open(filepath, "r", encoding="utf-8") as f:
            data = json.load(f)
        if data.get("id_token_email"):
            return data.get("id_token_email")
        if data.get("email"):
            return data.get("email")
        id_token = data.get("id_token")
        if id_token:
            parts = id_token.split(".")
            if len(parts) >= 2:
                payload_part = parts[1]
                payload_part += "=" * (-len(payload_part) % 4)
                payload_json = json.loads(base64.urlsafe_b64decode(payload_part))
                return payload_json.get("email")
    except Exception:
        pass
    return None

def get_expiry(filepath):
    try:
        with open(filepath, "r", encoding="utf-8") as f:
            data = json.load(f)
        expiry_str = data.get("token", {}).get("expiry")
        if expiry_str:
            return expiry_str.split(".")[0].replace("T", " ")
    except Exception:
        pass
    return "N/A"

AVAILABLE_MODELS = [
    {"name": "Gemini 3.8 Flash", "has_effort": True},
    {"name": "Claude Sonnet 4.6 (Thinking)", "has_effort": False},
    {"name": "Claude Opus 4.6 (Thinking)", "has_effort": False},
    {"name": "GPT-OSS 120B (Medium)", "has_effort": True},
    {"name": "Gemini 4 Argon", "has_effort": False}
]
EFFORT_LEVELS = ["low", "medium", "high"]

def get_full_rotation_config():
    cfg = {"accounts": {}, "models": {}, "effort": "medium", "auto_rotation_enabled": True}
    if os.path.exists(ROTATION_CONFIG):
        try:
            with open(ROTATION_CONFIG, "r", encoding="utf-8") as f:
                data = json.load(f)
                if isinstance(data, dict):
                    cfg["accounts"] = data.get("accounts", {})
                    cfg["models"] = data.get("models", {})
                    cfg["effort"] = data.get("effort", "medium")
                    cfg["auto_rotation_enabled"] = data.get("auto_rotation_enabled", True)
        except Exception:
            pass
    # Ensure default accounts
    accounts = get_accounts(load_cfg=False)
    updated = False
    for acc in accounts:
        if acc["email"] not in cfg["accounts"]:
            cfg["accounts"][acc["email"]] = True
            updated = True
    # Ensure default models
    for m in AVAILABLE_MODELS:
        if m["name"] not in cfg["models"]:
            cfg["models"][m["name"]] = True
            updated = True
    if "auto_rotation_enabled" not in cfg:
        cfg["auto_rotation_enabled"] = True
        updated = True
    if updated or not os.path.exists(ROTATION_CONFIG):
        save_full_rotation_config(cfg)
    return cfg

def save_full_rotation_config(cfg):
    try:
        with open(ROTATION_CONFIG, "w", encoding="utf-8") as f:
            json.dump(cfg, f, indent=2)
    except Exception:
        pass

def is_auto_rotation_enabled():
    return get_full_rotation_config().get("auto_rotation_enabled", True)

def set_auto_rotation_enabled(enabled: bool):
    full = get_full_rotation_config()
    full["auto_rotation_enabled"] = bool(enabled)
    save_full_rotation_config(full)
    return full["auto_rotation_enabled"]

def get_rotation_config():
    return get_full_rotation_config().get("accounts", {})

def save_rotation_config(acc_cfg):
    full = get_full_rotation_config()
    full["accounts"] = acc_cfg
    save_full_rotation_config(full)

def toggle_rotation_account(email):
    full = get_full_rotation_config()
    current = full["accounts"].get(email, True)
    full["accounts"][email] = not current
    save_full_rotation_config(full)
    return full["accounts"][email]

def get_model_rotation_config():
    return get_full_rotation_config().get("models", {})

def toggle_model_rotation(identifier):
    full = get_full_rotation_config()
    models_cfg = full.get("models", {})
    target_name = None
    
    if str(identifier).isdigit():
        idx = int(identifier) - 1
        if 0 <= idx < len(AVAILABLE_MODELS):
            target_name = AVAILABLE_MODELS[idx]["name"]
    else:
        ident = str(identifier).lower().strip()
        for m in AVAILABLE_MODELS:
            if ident in m["name"].lower():
                target_name = m["name"]
                break
                
    if not target_name:
        return False, f"Model '{identifier}' tidak ditemukan.", False

    curr_val = models_cfg.get(target_name, True)
    models_cfg[target_name] = not curr_val
    full["models"] = models_cfg
    save_full_rotation_config(full)
    return True, target_name, models_cfg[target_name]

def get_current_model():
    current_model = "Gemini 3.8 Flash (High)"
    if os.path.exists(SETTINGS_FILE):
        try:
            with open(SETTINGS_FILE, "r", encoding="utf-8") as f:
                current_model = json.load(f).get("model", current_model)
        except Exception:
            pass
    return current_model

def get_current_effort():
    cur = get_current_model()
    for eff in ("High", "Medium", "Low"):
        if f"({eff})" in cur:
            return eff.lower()
    full = get_full_rotation_config()
    return full.get("effort", "medium")

def format_model_full_name(model_obj, effort_level):
    name = model_obj["name"]
    if model_obj["has_effort"]:
        eff_cap = effort_level.capitalize()
        if "(" in name and ("Low" in name or "Medium" in name or "High" in name):
            base = name.split("(")[0].strip()
            return f"{base} ({eff_cap})"
        else:
            return f"{name} ({eff_cap})"
    return name

def set_model_in_settings(full_model_name):
    settings = {}
    if os.path.exists(SETTINGS_FILE):
        try:
            with open(SETTINGS_FILE, "r", encoding="utf-8") as f:
                settings = json.load(f)
        except Exception:
            settings = {}
    settings["model"] = full_model_name
    for eff in ("High", "Medium", "Low"):
        if f"({eff})" in full_model_name:
            full = get_full_rotation_config()
            full["effort"] = eff.lower()
            save_full_rotation_config(full)
            break
    try:
        with open(SETTINGS_FILE, "w", encoding="utf-8") as f:
            json.dump(settings, f, indent=2)
        return True, full_model_name
    except Exception as e:
        return False, str(e)

def set_model_internal(identifier):
    effort = get_current_effort()
    target_model = None
    if str(identifier).isdigit():
        idx = int(identifier) - 1
        if 0 <= idx < len(AVAILABLE_MODELS):
            target_model = AVAILABLE_MODELS[idx]
    else:
        ident = str(identifier).lower().strip()
        for m in AVAILABLE_MODELS:
            if ident in m["name"].lower():
                target_model = m
                break
    if not target_model:
        return False, f"Model '{identifier}' tidak ditemukan."
    full_name = format_model_full_name(target_model, effort)
    return set_model_in_settings(full_name)

def set_effort_internal(effort_level):
    eff = str(effort_level).lower().strip()
    if eff not in EFFORT_LEVELS:
        return False, f"Effort harus salah satu dari: {', '.join(EFFORT_LEVELS)}"
    full = get_full_rotation_config()
    full["effort"] = eff
    save_full_rotation_config(full)
    
    cur_model_str = get_current_model()
    for m in AVAILABLE_MODELS:
        base_name = m["name"].split("(")[0].strip()
        if base_name in cur_model_str:
            if m["has_effort"]:
                new_full = format_model_full_name(m, eff)
                set_model_in_settings(new_full)
                return True, f"{new_full} (effort: {eff})"
    return True, f"Effort set to {eff}"

def nav_model_internal(direction):
    dir_str = str(direction).lower().strip()
    cur_model_str = get_current_model()
    current_idx = 0
    for idx, m in enumerate(AVAILABLE_MODELS):
        base_name = m["name"].split("(")[0].strip()
        if base_name in cur_model_str:
            current_idx = idx
            break
            
    if dir_str in ("up", "atas", "u", "prev"):
        new_idx = (current_idx - 1) % len(AVAILABLE_MODELS)
    elif dir_str in ("down", "bawah", "d", "next"):
        new_idx = (current_idx + 1) % len(AVAILABLE_MODELS)
    else:
        return False, "Arah harus 'up' atau 'down'."

    effort = get_current_effort()
    target_model = AVAILABLE_MODELS[new_idx]
    full_name = format_model_full_name(target_model, effort)
    return set_model_in_settings(full_name)

def nav_effort_internal(direction):
    dir_str = str(direction).lower().strip()
    current_effort = get_current_effort()
    try:
        eff_idx = EFFORT_LEVELS.index(current_effort)
    except ValueError:
        eff_idx = 1
        
    if dir_str in ("left", "kiri", "l", "prev"):
        new_eff_idx = max(0, eff_idx - 1)
    elif dir_str in ("right", "kanan", "r", "next"):
        new_eff_idx = min(len(EFFORT_LEVELS) - 1, eff_idx + 1)
    else:
        return False, "Arah harus 'left' atau 'right'."

    new_eff = EFFORT_LEVELS[new_eff_idx]
    return set_effort_internal(new_eff)

def get_models_status():
    cur_model_str = get_current_model()
    cur_effort = get_current_effort()
    model_cfg = get_model_rotation_config()
    
    result = []
    for idx, m in enumerate(AVAILABLE_MODELS, 1):
        full_name = format_model_full_name(m, cur_effort)
        base_name = m["name"].split("(")[0].strip()
        is_active = (base_name in cur_model_str)
        auto_rotate = model_cfg.get(m["name"], True)
        result.append({
            "index": idx,
            "name": m["name"],
            "full_name": full_name,
            "is_active": is_active,
            "auto_rotate": auto_rotate,
            "has_effort": m["has_effort"]
        })
    return result

def get_accounts(load_cfg=True):
    files = sorted([f for f in os.listdir(ACCOUNTS_DIR) if f.endswith(".token")])
    accs = []
    active_email = get_email_from_token_file(ACTIVE_TOKEN)
    rot_cfg = get_rotation_config() if load_cfg else {}
    for f in files:
        path = os.path.join(ACCOUNTS_DIR, f)
        email = get_email_from_token_file(path) or f[:-6]
        is_curr = (active_email is not None and email.lower() == active_email.lower())
        auto_rotate = rot_cfg.get(email, True) if load_cfg else True
        accs.append({
            "file": f,
            "path": path,
            "email": email,
            "expiry": get_expiry(path),
            "is_active": is_curr,
            "auto_rotate": auto_rotate
        })
    return accs

def sync_active_token():
    """Sync refreshed active token back to accounts directory if it belongs to one of the accounts."""
    if not os.path.exists(ACTIVE_TOKEN):
        return
    active_email = get_email_from_token_file(ACTIVE_TOKEN)
    if not active_email:
        return
    target_file = os.path.join(ACCOUNTS_DIR, f"{active_email}.token")
    try:
        shutil.copy2(ACTIVE_TOKEN, target_file)
    except Exception:
        pass

def save_current_token(label=None):
    if not os.path.exists(ACTIVE_TOKEN):
        return False
    email = get_email_from_token_file(ACTIVE_TOKEN)
    target_name = label if label else (email if email else "default")
    if not target_name.endswith(".token"):
        target_name += ".token"
    dest = os.path.join(ACCOUNTS_DIR, target_name)
    shutil.copy2(ACTIVE_TOKEN, dest)
    return True

def switch_account_internal(identifier):
    accounts = get_accounts()
    if not accounts:
        return False, "Tidak ada akun terdaftar."
    
    target = None
    if str(identifier).isdigit():
        idx = int(identifier) - 1
        if 0 <= idx < len(accounts):
            target = accounts[idx]
    else:
        ident = str(identifier).lower().strip()
        for acc in accounts:
            if ident in acc["email"].lower() or ident in acc["file"].lower():
                target = acc
                break

    if not target:
        return False, f"Akun '{identifier}' tidak ditemukan."

    sync_active_token()
    shutil.copy2(target["path"], ACTIVE_TOKEN)
    return True, target["email"]

def rotate_account_internal():
    if not is_auto_rotation_enabled():
        return False, "Zero-Interruption Auto-Rotation sedang dinonaktifkan."

    accounts = get_accounts()
    if not accounts:
        return False, "Belum ada akun di daftar."
    
    sync_active_token()
    rot_cfg = get_rotation_config()

    # Filter only accounts enabled for auto-rotation (auto_rotate == True)
    enabled_accounts = [acc for acc in accounts if rot_cfg.get(acc["email"], True)]
    if not enabled_accounts:
        return False, "Semua akun disetel OFF dalam pool auto-rotation."

    if len(enabled_accounts) == 1:
        # Switch to the single enabled account if not already active
        target = enabled_accounts[0]
        shutil.copy2(target["path"], ACTIVE_TOKEN)
        return True, target["email"]

    active_email = get_email_from_token_file(ACTIVE_TOKEN)
    current_idx = -1
    for idx, acc in enumerate(enabled_accounts):
        if active_email and acc["email"].lower() == active_email.lower():
            current_idx = idx
            break
            
    next_idx = (current_idx + 1) % len(enabled_accounts)
    next_acc = enabled_accounts[next_idx]
    shutil.copy2(next_acc["path"], ACTIVE_TOKEN)
    return True, next_acc["email"]

